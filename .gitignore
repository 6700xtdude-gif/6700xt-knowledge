# Model files and heavy artifacts
*.gguf
*.safetensors
*.bin
*.pt
*.onnx
# Ignore artifacts dropped in models/ but KEEP the KB's own docs there
# (models/what-fits-12gb.md is tracked and linked from index.md/README.md).
models/*
!models/*.md

# Local environments
.venv/
venv/
env/
node_modules/

# Logs and scratch
*.log
*.tmp
scratch/
.cache/

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Secrets — never commit these
.env
*.key
*.token
secrets/
